@page "/"

<div class="tt-bookStage" style="max-width: 800px;">
    @* We use a single page layout here to act as the "Cover" or "Intro" *@
    <div class="tt-page" style="text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 600px;">
        
        <div style="margin-bottom: 20px;">
            <span style="font-size: 3rem; color: #3d2b1f; opacity: 0.8;">𝄞</span>
            <h1 style="font-family: 'Uncial Antiqua', serif; font-size: 3.5rem; color: #3d2b1f; margin: 0; line-height: 1;">Theory Trials</h1>
            <div style="width: 150px; height: 2px; background: #8b4513; margin: 15px auto; opacity: 0.5;"></div>
        </div>

        <p style="font-family: 'Crimson Text', serif; font-size: 1.4rem; font-style: italic; color: #5d4037; max-width: 80%;">
            "Space-grade music theory training. Learn the ancient harmonies, then prove your mastery in the trials."
        </p>

        <div style="display: flex; gap: 15px; margin-top: 40px; flex-wrap: wrap; justify-content: center;">
            <a href="play" class="adventure-btn" style="text-decoration: none; padding: 15px 30px; display: inline-block;">
                ▶ Begin Trials
            </a>
            <a href="learn" class="adventure-btn" style="text-decoration: none; padding: 15px 30px; display: inline-block; background: #5d4037 !important;">
                📖 Study Lore
            </a>
            <a href="hub" class="adventure-btn" style="text-decoration: none; padding: 15px 30px; display: inline-block; background: #3d2b1f !important;">
                📊 View Archives
            </a>
        </div>

        <div style="margin-top: 50px; font-family: 'Crimson Text', serif; color: #8b4513; font-weight: bold; border-top: 1px solid rgba(139, 69, 19, 0.2); padding-top: 20px;">
            <span style="opacity: 0.7;">📜 Tip: Start with <strong>Learn</strong> to sharpen your mind, then hit <strong>Play</strong>.</span>
        </div>

        <div style="position: absolute; bottom: 30px; right: 40px; opacity: 0.1; font-size: 5rem; pointer-events: none;">𝄢</div>
    </div>
</div>