@page "/"
@using System.Linq

<div class="container mt-4">
    <h1 class="text-center">🎵 Music Theory Trainer</h1>

    <div class="card p-4 shadow-sm">
        @if (!arcadeActive && !isQuizActive)
        {
            <div class="text-center">
                <button class="btn btn-fire btn-lg m-2" @onclick="StartArcade">🔥 Start Arcade Mode</button>
                <div class="mt-3">
                    <button class="btn btn-outline-primary m-1" @onclick="() => StartSingleQuiz(0)">Interval Quiz</button>
                    <button class="btn btn-outline-primary m-1" @onclick="() => StartSingleQuiz(1)">Scale Degree Quiz</button>
                    <button class="btn btn-outline-primary m-1" @onclick="() => StartSingleQuiz(2)">Chord Quiz</button>
                </div>
            </div>
        }
        else
        {
            <div class="quiz-header d-flex justify-content-between mb-3">
                <span>❤️ Lives: @lives</span>
                <span>⭐ Level: @level</span>
                <span>📈 Run Score: @runScore</span>
            </div>

            <div class="question-box bg-dark text-white p-4 rounded text-center mb-3">
                <h3>@questionText</h3>
                <small class="text-muted">@hintText</small>
            </div>

            <div class="input-group mb-3">
                <input @bind="userAnswer" @bind:event="oninput" @onkeyup="HandleKeyUp" class="form-control" placeholder="Type answer..." autofocus />
                <button class="btn btn-success" @onclick="CheckAnswer">Submit</button>
            </div>

            @if (!string.IsNullOrEmpty(feedback))
            {
                <div class="alert @feedbackClass">@feedback</div>
                <button class="btn btn-secondary w-100" @onclick="NextQuestion">Next Question</button>
            }
        }
    </div>

    <div class="mt-4 text-center">
        <p>Total Score: @correctCount/@totalCount | Best Streak: @bestStreak</p>
    </div>
</div>

@code {
    // --- DATA FROM YOUR ORIGINAL PROGRAM.CS ---
    private static readonly string[] Notes = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    private static readonly int[] MajorSteps = [0, 2, 4, 5, 7, 9, 11];
    private static readonly (string Name, int Semitones)[] Intervals = [
        ("m2", 1), ("M2", 2), ("m3", 3), ("M3", 4), ("P4", 5), ("TT", 6), ("P5", 7), ("m6", 8), ("M6", 9), ("m7", 10), ("M7", 11), ("P8", 12)
    ];

    // --- STATE MANAGEMENT ---
    private bool arcadeActive = false;
    private bool isQuizActive = false;
    private string questionText = "";
    private string hintText = "";
    private string correctAnswer = "";
    private string userAnswer = "";
    private string feedback = "";
    private string feedbackClass = "";
    
    private int lives = 3;
    private int level = 1;
    private int runScore = 0;
    private int correctCount = 0;
    private int totalCount = 0;
    private int bestStreak = 0;
    private int currentStreak = 0;
    private int currentMode = 0; // 0=Interval, 1=Degree, 2=Chord

    private Random rng = new();

    private void StartArcade() {
        arcadeActive = true;
        lives = 3;
        level = 1;
        runScore = 0;
        NextQuestion();
    }

    private void StartSingleQuiz(int mode) {
        isQuizActive = true;
        currentMode = mode;
        NextQuestion();
    }

    private void NextQuestion() {
        userAnswer = "";
        feedback = "";
        if (arcadeActive) currentMode = rng.Next(3);
        
        if (currentMode == 0) SetupInterval();
        else if (currentMode == 1) SetupDegree();
        else SetupChord();
    }

    private void SetupInterval() {
        var start = Notes[rng.Next(Notes.Length)];
        var interval = Intervals[rng.Next(Intervals.Length)];
        questionText = $"What is {start} + {interval.Name}?";
        correctAnswer = Transpose(start, interval.Semitones);
        hintText = "Enter a single note (e.g., F#)";
    }

    private void SetupDegree() {
        var key = Notes[rng.Next(Notes.Length)];
        int degreeIdx = rng.Next(7);
        var scale = BuildMajorScale(key);
        questionText = $"In {key} major, what is degree {degreeIdx + 1}?";
        correctAnswer = scale[degreeIdx];
    }

    private void SetupChord() {
        var root = Notes[rng.Next(Notes.Length)];
        questionText = $"Spell the {root} Major triad:";
        correctAnswer = $"{Transpose(root, 0)} {Transpose(root, 4)} {Transpose(root, 7)}";
        hintText = "Enter 3 notes separated by spaces.";
    }

    private void CheckAnswer() {
        totalCount++;
        bool isCorrect = false;

        if (currentMode == 2) {
            var userTones = new HashSet<string>(userAnswer.ToUpper().Split(' ', StringSplitOptions.RemoveEmptyEntries));
            var correctTones = new HashSet<string>(correctAnswer.ToUpper().Split(' '));
            isCorrect = userTones.SetEquals(correctTones);
        } else {
            isCorrect = userAnswer.Trim().ToUpper() == correctAnswer.ToUpper();
        }

        if (isCorrect) {
            feedback = "✅ Correct!";
            feedbackClass = "alert-success";
            correctCount++;
            currentStreak++;
            runScore++;
            if (runScore % 5 == 0) level++;
            if (currentStreak > bestStreak) bestStreak = currentStreak;
        } else {
            feedback = $"❌ Wrong! Answer was: {correctAnswer}";
            feedbackClass = "alert-danger";
            currentStreak = 0;
            if (arcadeActive) lives--;
        }

        if (lives <= 0) {
            feedback = "💀 Game Over!";
            arcadeActive = false;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") CheckAnswer(); }

    private string Transpose(string start, int semitones) {
        int i = Array.IndexOf(Notes, start);
        int moved = (i + semitones) % 12;
        return Notes[moved < 0 ? moved + 12 : moved];
    }

    private string[] BuildMajorScale(string key) {
        int root = Array.IndexOf(Notes, key);
        return MajorSteps.Select(step => Notes[(root + step) % 12]).ToArray();
    }
}